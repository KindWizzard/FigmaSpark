{
  "name": "figma-spark",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local, persistent Figma bridge for skill-driven design review.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "start": "node bridge/server.mjs",
    "spark": "node scripts/spark.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "dependencies": { "ws": "^8.18.3" },
  "devDependencies": {
    "@figma/plugin-typings": "^1.118.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
